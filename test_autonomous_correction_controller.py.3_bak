import tempfile
import time
import unittest
from pathlib import Path

from PySide6.QtCore import QCoreApplication, Signal

from autonomy.autonomous_correction_controller import (
    AutonomousCorrectionController,
    AutonomousCorrectionState,
)


_APP = QCoreApplication.instance() or QCoreApplication([])


class FakeApprovalManager:
    def __init__(self):
        self.records = {}
        self.counter = 0

    def request_approval(self, proposal):
        self.counter += 1
        proposal_id = f"proposal-{self.counter}"
        self.records[proposal_id] = {
            "proposal": proposal,
            "status": "pending",
        }
        return proposal_id

    def approve(self, proposal_id):
        if self.records[proposal_id]["status"] != "pending":
            return False
        self.records[proposal_id]["status"] = "approved"
        return True

    def reject(self, proposal_id):
        if self.records[proposal_id]["status"] != "pending":
            return False
        self.records[proposal_id]["status"] = "rejected"
        return True

    def get_status(self, proposal_id):
        return self.records[proposal_id]["status"]


class FakeProposalService:
    def __init__(self, retry_paths=None):
        self.calls = []
        self.retry_paths = list(retry_paths or [])

    def create_proposal(self, action, relative_path, inventory):
        self.calls.append((action, relative_path, inventory))
        path = self.retry_paths.pop(0) if self.retry_paths else relative_path
        return {
            "relative_path": path,
            "expected_sha256": "a" * 64,
            "original_snippet": "old_value",
            "replacement_snippet": "new_value",
            "explanation": "Correção simulada para teste.",
        }


class FakeWorkflow:
    proposal_ready = Signal(object)
    proposal_failed = Signal(str)

    def __init__(self, root, *, action_files=None):
        self.approval_manager = FakeApprovalManager()
        self.patch_proposal_service = FakeProposalService()
        self.state = "awaiting_approval"
        self.last_result = {
            "plan": {
                "actions": [{
                    "id": "action-1",
                    "description": "Corrigir firmware.",
                    "files": list(action_files or ["main.c"]),
                }]
            },
            "planning_input": {
                "inventory": [
                    {"path": "main.c", "size": 100},
                    {"path": "other.c", "size": 100},
                ]
            },
        }
        self.root = root
        self.requested = []

    def request_patch_proposal_async(self, action_id, relative_path):
        self.requested.append((action_id, relative_path))
        proposal = {
            "relative_path": relative_path,
            "expected_sha256": "a" * 64,
            "original_snippet": "old_value",
            "replacement_snippet": "new_value",
            "explanation": "Primeira proposta simulada.",
        }
        proposal_id = self.approval_manager.request_approval(proposal)
        self.proposal_ready.emit({
            "proposal_id": proposal_id,
            "proposal": proposal,
            "action_id": action_id,
            "relative_path": relative_path,
        })


class FakeApplier:
    def __init__(self, *, success=True):
        self.calls = []
        self.success = success

    def apply_approved(self, proposal_id, project_root):
        self.calls.append((proposal_id, Path(project_root)))
        if not self.success:
            return {"success": False, "reason": "simulated apply failure"}
        return {"success": True, "proposal_id": proposal_id}


class FakeBuildResult:
    def __init__(self, success, *, cancelled=False, returncode=0, errors=None):
        self.success = success
        self.cancelled = cancelled
        self.returncode = returncode
        self.errors = list(errors or [])
        self.output = "Build output"


class FakeCompiler:
    def __init__(self, outcomes=None, block_until_cancel=False):
        self.outcomes = list(outcomes or [True])
        self.calls = []
        self.block_until_cancel = block_until_cancel

    def resolve_project(self, project_dir):
        return str(Path(project_dir).resolve())

    def build(self, project_dir, cancel_event=None):
        self.calls.append(("build", str(Path(project_dir).resolve())))
        if self.block_until_cancel:
            while cancel_event is not None and not cancel_event.is_set():
                time.sleep(0.01)
            return FakeBuildResult(False, cancelled=True, returncode=-1)
        success = self.outcomes.pop(0) if self.outcomes else False
        return FakeBuildResult(
            success,
            returncode=0 if success else 1,
            errors=[] if success else ["simulated compiler error"],
        )


class AutonomousCorrectionControllerTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.root = Path(self.temp.name)
        (self.root / "CMakeLists.txt").write_text("project(test)", encoding="utf-8")
        (self.root / "main.c").write_text("int main(void) { return 0; }", encoding="utf-8")
        self.workflow = FakeWorkflow(self.root)
        self.applier = FakeApplier()
        self.compiler = FakeCompiler([True])
        self.controller = AutonomousCorrectionController(
            self.workflow,
            self.applier,
            self.compiler,
            self.root,
            approval_poll_interval_ms=100,
        )

    def tearDown(self):
        if self.controller.is_active:
            self.controller.cancel()
            self.wait_until(lambda: not self.controller.is_active, timeout=2)
        self.temp.cleanup()

    def wait_until(self, predicate, timeout=3):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            _APP.processEvents()
            if predicate():
                return True
            time.sleep(0.01)
        _APP.processEvents()
        return bool(predicate())

    def start(self, max_attempts=3):
        return self.controller.start_session(
            "action-1",
            "main.c",
            authorize_session=True,
            authorize_automatic_retries=True,
            max_attempts=max_attempts,
        )

    def approve_first(self):
        self.assertTrue(self.wait_until(lambda: bool(self.workflow.approval_manager.records)))
        proposal_id = next(iter(self.workflow.approval_manager.records))
        self.workflow.approval_manager.approve(proposal_id)
        return proposal_id

    def test_session_requires_explicit_authorization(self):
        with self.assertRaises(PermissionError):
            self.controller.start_session(
                "action-1", "main.c",
                authorize_session=False,
                authorize_automatic_retries=True,
            )
        self.assertFalse(self.controller.is_active)
        self.assertEqual(self.applier.calls, [])

    def test_first_proposal_waits_for_human_approval(self):
        self.start()
        self.assertEqual(self.controller.state, AutonomousCorrectionState.AWAITING_APPROVAL)
        _APP.processEvents()
        self.assertEqual(self.applier.calls, [])
        self.assertEqual(self.compiler.calls, [])

        self.approve_first()
        self.assertTrue(self.wait_until(lambda: not self.controller.is_active))
        self.assertEqual(self.controller.state, AutonomousCorrectionState.COMPLETED)
        self.assertEqual(self.controller.attempts, 1)

    def test_automatic_retries_stop_after_three_attempts(self):
        self.compiler = FakeCompiler([False, False, False])
        self.controller = AutonomousCorrectionController(
            self.workflow, self.applier, self.compiler, self.root,
            approval_poll_interval_ms=100,
        )
        self.start(max_attempts=3)
        self.approve_first()

        self.assertTrue(self.wait_until(lambda: not self.controller.is_active, timeout=5))
        self.assertEqual(self.controller.state, AutonomousCorrectionState.FAILED)
        self.assertEqual(self.controller.attempts, 3)
        self.assertEqual(len(self.applier.calls), 3)
        self.assertEqual(len(self.compiler.calls), 3)
        self.assertEqual(len(self.workflow.patch_proposal_service.calls), 2)

    def test_successful_build_stops_without_retry(self):
        self.compiler = FakeCompiler([True, False, False])
        self.controller = AutonomousCorrectionController(
            self.workflow, self.applier, self.compiler, self.root,
            approval_poll_interval_ms=100,
        )
        self.start()
        self.approve_first()

        self.assertTrue(self.wait_until(lambda: not self.controller.is_active))
        self.assertEqual(self.controller.state, AutonomousCorrectionState.COMPLETED)
        self.assertEqual(self.controller.attempts, 1)
        self.assertEqual(len(self.compiler.calls), 1)
        self.assertEqual(self.workflow.patch_proposal_service.calls, [])

    def test_apply_failure_stops_without_build_or_retry(self):
        self.applier = FakeApplier(success=False)
        self.controller = AutonomousCorrectionController(
            self.workflow, self.applier, self.compiler, self.root,
            approval_poll_interval_ms=100,
        )
        self.start()
        self.approve_first()

        self.assertTrue(self.wait_until(lambda: not self.controller.is_active))
        self.assertEqual(self.controller.state, AutonomousCorrectionState.FAILED)
        self.assertEqual(self.controller.attempts, 1)
        self.assertEqual(self.compiler.calls, [])
        self.assertEqual(self.workflow.patch_proposal_service.calls, [])

    def test_cancel_stops_running_build(self):
        self.compiler = FakeCompiler([False], block_until_cancel=True)
        self.controller = AutonomousCorrectionController(
            self.workflow, self.applier, self.compiler, self.root,
            approval_poll_interval_ms=100,
        )
        self.start()
        self.approve_first()
        self.assertTrue(self.wait_until(lambda: bool(self.compiler.calls)))
        self.assertTrue(self.controller.cancel())
        self.assertTrue(self.wait_until(lambda: not self.controller.is_active))
        self.assertEqual(self.controller.state, AutonomousCorrectionState.CANCELLED)
        self.assertEqual(self.controller.attempts, 1)
        self.assertEqual(len(self.compiler.calls), 1)

    def test_file_outside_authorized_action_is_rejected(self):
        with self.assertRaises(PermissionError):
            self.controller.start_session(
                "action-1", "other.c",
                authorize_session=True,
                authorize_automatic_retries=True,
                max_attempts=3,
            )
        self.assertFalse(self.controller.is_active)
        self.assertEqual(self.workflow.requested, [])

    def test_retry_proposal_for_another_file_is_blocked(self):
        self.compiler = FakeCompiler([False, True])
        self.workflow.patch_proposal_service.retry_paths = ["other.c"]
        self.controller = AutonomousCorrectionController(
            self.workflow, self.applier, self.compiler, self.root,
            approval_poll_interval_ms=100,
        )
        self.start()
        self.approve_first()

        self.assertTrue(self.wait_until(lambda: not self.controller.is_active, timeout=5))
        self.assertEqual(self.controller.state, AutonomousCorrectionState.FAILED)
        self.assertEqual(self.controller.attempts, 1)
        self.assertEqual(len(self.applier.calls), 1)
        self.assertEqual(len(self.compiler.calls), 1)

    def test_rejected_first_proposal_stops_session(self):
        self.start()
        self.assertTrue(self.wait_until(lambda: bool(self.workflow.approval_manager.records)))
        proposal_id = next(iter(self.workflow.approval_manager.records))
        self.workflow.approval_manager.reject(proposal_id)

        self.assertTrue(self.wait_until(lambda: not self.controller.is_active))
        self.assertEqual(self.controller.state, AutonomousCorrectionState.FAILED)
        self.assertEqual(self.controller.attempts, 0)
        self.assertEqual(self.applier.calls, [])
        self.assertEqual(self.compiler.calls, [])

    def test_attempt_limit_cannot_exceed_three(self):
        with self.assertRaises(ValueError):
            self.controller.start_session(
                "action-1", "main.c",
                authorize_session=True,
                authorize_automatic_retries=True,
                max_attempts=4,
            )
        self.assertFalse(self.controller.is_active)

    def test_only_build_operation_is_invoked(self):
        self.start()
        self.approve_first()
        self.assertTrue(self.wait_until(lambda: not self.controller.is_active))
        self.assertTrue(all(call[0] == "build" for call in self.compiler.calls))
        self.assertEqual(len(self.compiler.calls), 1)


if __name__ == "__main__":
    unittest.main()
