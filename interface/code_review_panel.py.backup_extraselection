from pathlib import Path

from PySide6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QPushButton, QListWidget, QListWidgetItem,
    QSplitter, QPlainTextEdit, QMessageBox
)

from PySide6.QtCore import Qt, QRect, QSize
from PySide6.QtGui import (
    QColor, QPainter, QTextFormat, QTextCursor
)

from project_engine.project_context import build_project_context


class LineNumberArea(QWidget):

    def __init__(self, editor):
        super().__init__(editor)
        self.editor = editor

    def sizeHint(self):
        return QSize(self.editor.line_number_area_width(), 0)

    def paintEvent(self, event):
        self.editor.paint_line_number_area(event)


class CodeEditor(QPlainTextEdit):

    def __init__(self):
        super().__init__()

        self.line_number_area = LineNumberArea(self)

        self.setReadOnly(True)
        self.setLineWrapMode(QPlainTextEdit.LineWrapMode.NoWrap)

        self.setStyleSheet("""
            QPlainTextEdit {
                background-color: #111827;
                color: #E5E7EB;
                border: none;
                font-family: Consolas;
                font-size: 12px;
            }
        """)

        self.blockCountChanged.connect(
            self.update_line_number_area_width
        )

        self.updateRequest.connect(
            self.update_line_number_area
        )

        self.update_line_number_area_width(0)

    def line_number_area_width(self):

        digits = len(str(max(1, self.blockCount())))

        return 15 + self.fontMetrics().horizontalAdvance("9") * digits

    def update_line_number_area_width(self, _):

        self.setViewportMargins(
            self.line_number_area_width(), 0, 0, 0
        )

    def update_line_number_area(self, rect, dy):

        if dy:
            self.line_number_area.scroll(0, dy)
        else:
            self.line_number_area.update(
                0,
                rect.y(),
                self.line_number_area.width(),
                rect.height()
            )

        if rect.contains(self.viewport().rect()):
            self.update_line_number_area_width(0)

    def resizeEvent(self, event):

        super().resizeEvent(event)

        contents = self.contentsRect()

        self.line_number_area.setGeometry(
            QRect(
                contents.left(),
                contents.top(),
                self.line_number_area_width(),
                contents.height()
            )
        )

    def paint_line_number_area(self, event):

        painter = QPainter(self.line_number_area)

        painter.fillRect(
            event.rect(),
            QColor("#1F2937")
        )

        block = self.firstVisibleBlock()
        block_number = block.blockNumber()

        top = int(
            self.blockBoundingGeometry(block)
            .translated(self.contentOffset())
            .top()
        )

        bottom = top + int(
            self.blockBoundingRect(block).height()
        )

        while block.isValid() and top <= event.rect().bottom():

            if block.isVisible() and bottom >= event.rect().top():

                painter.setPen(QColor("#94A3B8"))

                painter.drawText(
                    0,
                    top,
                    self.line_number_area.width() - 8,
                    self.fontMetrics().height(),
                    Qt.AlignmentFlag.AlignRight,
                    str(block_number + 1)
                )

            block = block.next()
            top = bottom

            bottom = top + int(
                self.blockBoundingRect(block).height()
            )

            block_number += 1

    def highlight_line(self, line_number):

        if line_number < 1:
            return

        block = self.document().findBlockByNumber(
            line_number - 1
        )

        if not block.isValid():
            return

        cursor = QTextCursor(block)

        self.setTextCursor(cursor)
        self.centerCursor()

        selection = QPlainTextEdit.ExtraSelection()

        selection.format.setBackground(
            QColor("#57451D")
        )

        selection.format.setProperty(
            QTextFormat.Property.FullWidthSelection,
            True
        )

        selection.cursor = cursor

        self.setExtraSelections([selection])


class CodeReviewPanel(QWidget):

    def __init__(self):
        super().__init__()

        self.project_path_provider = None
        self.current_project = None
        self.findings = []

        layout = QVBoxLayout(self)

        header = QHBoxLayout()

        title = QLabel("VINI_JR - CODE REVIEW")
        title.setStyleSheet(
            "font-size: 18px; font-weight: bold;"
        )

        self.analyze_button = QPushButton("Analisar projeto")
        self.analyze_button.clicked.connect(
            self.analyze_project
        )

        self.status = QLabel(
            "Selecione um projeto e execute a analise."
        )

        header.addWidget(title)
        header.addStretch()
        header.addWidget(self.analyze_button)

        layout.addLayout(header)
        layout.addWidget(self.status)

        splitter = QSplitter(
            Qt.Orientation.Horizontal
        )

        # Painel esquerdo: diagnosticos

        left = QWidget()
        left_layout = QVBoxLayout(left)

        left_layout.addWidget(
            QLabel("DIAGNOSTICOS ENCONTRADOS")
        )

        self.findings_list = QListWidget()

        self.findings_list.currentItemChanged.connect(
            self.open_finding
        )

        left_layout.addWidget(self.findings_list)

        # Painel direito: codigo-fonte

        right = QWidget()
        right_layout = QVBoxLayout(right)

        self.file_label = QLabel(
            "Nenhum arquivo selecionado"
        )

        self.file_label.setStyleSheet(
            "font-weight: bold; color: #60A5FA;"
        )

        self.editor = CodeEditor()

        self.detail_label = QLabel(
            "Selecione um diagnostico para visualizar o codigo."
        )

        self.detail_label.setWordWrap(True)

        right_layout.addWidget(self.file_label)
        right_layout.addWidget(self.editor, 1)
        right_layout.addWidget(self.detail_label)

        splitter.addWidget(left)
        splitter.addWidget(right)

        splitter.setSizes([350, 900])

        layout.addWidget(splitter, 1)

    def set_project_path_provider(self, provider):

        self.project_path_provider = provider

    def analyze_project(self):

        if not self.project_path_provider:

            QMessageBox.warning(
                self,
                "Projeto",
                "Caminho do projeto nao configurado."
            )

            return

        project = self.project_path_provider()

        if not project:

            QMessageBox.warning(
                self,
                "Projeto",
                "Selecione um projeto na aba Embedded Development."
            )

            return

        self.analyze_button.setEnabled(False)
        self.status.setText("Analisando projeto...")

        try:

            context = build_project_context(project)

            self.current_project = Path(project).resolve()

            static = context.get("static_analysis", {})

            self.findings = static.get("findings", [])

            self.findings_list.clear()

            for index, finding in enumerate(self.findings):

                severity = finding.get(
                    "severity", "info"
                ).upper()

                rule = finding.get(
                    "rule", "UNKNOWN"
                )

                filename = finding.get(
                    "file", "arquivo desconhecido"
                )

                line = finding.get(
                    "line", 0
                )

                title = finding.get(
                    "title", "Diagnostico"
                )

                item = QListWidgetItem(
                    f"[{severity}] {rule}\n"
                    f"{filename}:{line}\n"
                    f"{title}"
                )

                item.setData(
                    Qt.ItemDataRole.UserRole,
                    index
                )

                if severity == "ERROR":
                    item.setForeground(QColor("#F87171"))

                elif severity == "WARNING":
                    item.setForeground(QColor("#FBBF24"))

                else:
                    item.setForeground(QColor("#93C5FD"))

                self.findings_list.addItem(item)

            counts = static.get("counts", {})

            self.status.setText(
                f"Projeto: {self.current_project} | "
                f"Arquivos: {static.get('files_analyzed', 0)} | "
                f"Achados: {len(self.findings)} | "
                f"Erros: {counts.get('error', 0)} | "
                f"Warnings: {counts.get('warning', 0)}"
            )

            if self.findings:

                self.findings_list.setCurrentRow(0)

            else:

                self.editor.clear()

                self.file_label.setText(
                    "Nenhum diagnostico"
                )

                self.detail_label.setText(
                    "Nenhum achado foi identificado pelas regras atuais."
                )

        except Exception as error:

            QMessageBox.critical(
                self,
                "Erro na analise",
                str(error)
            )

            self.status.setText(
                "Falha ao analisar projeto."
            )

        finally:

            self.analyze_button.setEnabled(True)

    def open_finding(self, current, previous=None):

        if current is None or self.current_project is None:
            return

        index = current.data(
            Qt.ItemDataRole.UserRole
        )

        if index is None:
            return

        finding = self.findings[index]

        relative_path = finding.get("file", "")
        line_number = int(finding.get("line", 1))

        try:

            root = self.current_project.resolve()

            target = (root / relative_path).resolve()

            # Bloqueia caminhos fora da raiz do projeto.

            try:
                target.relative_to(root)
            except ValueError:
                raise ValueError(
                    "O arquivo solicitado esta fora da pasta do projeto."
                )

            if not target.is_file():
                raise FileNotFoundError(
                    f"Arquivo nao encontrado: {target}"
                )

            try:
                source = target.read_text(
                    encoding="utf-8"
                )
            except UnicodeDecodeError:
                source = target.read_text(
                    encoding="latin-1"
                )

            self.editor.setPlainText(source)

            self.editor.highlight_line(line_number)

            self.file_label.setText(
                f"{relative_path} — Linha {line_number}"
            )

            self.detail_label.setText(
                f"Regra: {finding.get('rule', '')} | "
                f"Severidade: {finding.get('severity', '')}\n"
                f"Evidencia: {finding.get('evidence', '')}\n"
                f"Recomendacao: {finding.get('recommendation', '')}"
            )

        except Exception as error:

            QMessageBox.warning(
                self,
                "Erro ao abrir arquivo",
                str(error)
            )
